// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
      "version": "2.0.0",
      "tasks": [
            {
                  "type": "npm",
                  "label": "build",
                  "script": "compile",
                  "group": {
                        "kind": "build",
                        "isDefault": true
                  },
                  "problemMatcher": ["$tsc"]
            },
            {
                  "type": "npm",
                  "script": "watch",
                  "isBackground": true,
                  "problemMatcher": ["$tsc-watch", "$tsc"],
                  "label": "watch",
                  "detail": "Execute 'tsc -watch -p ./'."
            }
      ]
}
