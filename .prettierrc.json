{
      "semi": true,
      "trailingComma": "none",
      "singleQuote": true,
      "printWidth": 100,
      "tabWidth": 6,
      "useTabs": false,
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParens": "avoid",
      "endOfLine": "lf",
      "quoteProps": "as-needed",
      "embeddedLanguageFormatting": "auto"
}
